# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL=gemini-2.5-flash

# If true, the app returns synthetic Gemini-shaped responses instead of
# calling the real API. Useful for local development / demoing without
# burning API quota, or before you've gotten a key approved.
USE_MOCK_GEMINI=true

# Supabase project connection (Project Settings -> API in the Supabase dashboard).
# Use the service_role / secret key here, not the anon key — this server-side
# code needs to bypass RLS to write complaints/institute_matches directly.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_secret_key

# Server port
PORT=4000

# Geo-clustering radius for duplicate detection (kilometers)
DUPLICATE_RADIUS_KM=0.5

# Criticality score weights
WEIGHT_PEOPLE_AFFECTED=0.45
WEIGHT_SEVERITY=0.35
WEIGHT_DUPLICATE_COUNT=0.20

# How many institutes to keep in the keyword shortlist before asking
# Gemini to pick and justify the final top 3
SHORTLIST_SIZE=10
