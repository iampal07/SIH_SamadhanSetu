# ── Frontend (safe to expose — these end up in the browser bundle) ───────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# ── Server-side only. NEVER prefix these with VITE_ ─────────────────────────
# Used by scripts/seed-supabase.mjs when you want to bypass RLS while seeding.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# The Gemini key is NOT read from this file by the app. It lives in the
# Supabase Edge Function secrets so it never reaches the browser:
#
#   npx supabase login
#   npx supabase link --project-ref <your-project-ref>
#   npx supabase secrets set GEMINI_API_KEY=<your key> GEMINI_MODEL=gemini-2.5-flash
#
# Without it the ai-analyze function still runs, using the deterministic
# fallback engine, and the UI labels the result as such.
